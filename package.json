{
  "name": "yaypost",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Self-hosted social publishing run by AI agents: they draft, schedule and publish on X, Bluesky, Mastodon, Threads, LinkedIn, Telegram and Discord; you approve from Telegram or Discord. Single process, SQLite.",
  "bin": {
    "yaypost": "./cli/yaypost.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch --disable-warning=ExperimentalWarning --import tsx server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit",
    "cli": "node cli/yaypost.mjs",
    "operator": "tsx --disable-warning=ExperimentalWarning operator/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@date-fns/tz": "^1.5.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@scalar/hono-api-reference": "^0.12.0",
    "hono": "^4.13.14",
    "tsx": "^4.23.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.0.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  },
  "exports": {
    "./plugin": "./server/plugin-api.ts"
  }
}
