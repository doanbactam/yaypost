# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
# 127.0.0.1 = this machine only. Use 0.0.0.0 on a VPS (and set AUTH_TOKEN + put HTTPS in front).
HOST=127.0.0.1
# Required whenever the port is reachable from other machines. Generate it with: openssl rand -hex 32
# Unquoted values end at "#" (the rest is a comment) and lose surrounding spaces; wrap any other string in
# single quotes, e.g. AUTH_TOKEN='Xy7#kP2$q9…'. Variables already set in the environment win over this file.
AUTH_TOKEN=
# Give agents this one instead of AUTH_TOKEN (needs AUTH_TOKEN set): same API, but agents can't approve their own
# posts, resume publishing or touch accounts. Without it, everything except the web UI counts as an agent, which
# holds for agents that play fair; set it for a gate an agent can't get around.
AGENT_TOKEN=
# Full public URL (with https://), e.g. https://threads.example.com. Used in notification/webhook/llms.txt links
# and the OpenAPI server URL; its hostname is also accepted by the Host check below.
PUBLIC_URL=
# Without AUTH_TOKEN only localhost, HOST and PUBLIC_URL's hostname are answered (DNS-rebinding guard).
# Add LAN names/IPs here if you open the app from other devices without a token: ALLOWED_HOSTS=192.168.1.20,mybox.local
ALLOWED_HOSTS=

# Contact for Web Push (VAPID). Use a real mailto: or https: address; Apple's push service rejects localhost.
VAPID_SUBJECT=mailto:you@example.com

# ── Approval chats (optional; you can always approve in the web UI) ─────────
# Easier: set these on the Plugins page (telegram-approvals / discord-approvals → Settings); values here are the fallback.
# Telegram: create a bot with @BotFather, send it /start, then put your chat id here (e.g. from @userinfobot).
# Use a bot only for approvals (not one of your publishing accounts' bots). Works without a public URL.
TELEGRAM_APPROVAL_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_ID=
# Only these Telegram user ids may decide (comma-separated). Empty = anyone in that chat.
TELEGRAM_APPROVER_IDS=
# Discord: a bot (discord.com/developers → Bot → token) invited with View Channel + Send Messages in one channel.
DISCORD_APPROVAL_BOT_TOKEN=
DISCORD_APPROVAL_CHANNEL_ID=
DISCORD_APPROVER_IDS=

# ── Operator (optional; read by `pnpm operator`, not by the server) ─────────
# Claude doing the work from operator.md, as an agent over MCP. Run it with cron, or `pnpm operator --watch`.
# YAYPOST_URL=http://127.0.0.1:3000
# Token it uses: YAYPOST_TOKEN, else AGENT_TOKEN, else AUTH_TOKEN. It is always treated as an agent.
# YAYPOST_TOKEN=
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# Or GLM through Z.ai (https://z.ai/manage-apikey/apikey-list); default model glm-5.3-flash (also glm-5.3-flashx, glm-5.3).
# ZAI_API_KEY=
# With both keys set, pick one: AI_PROVIDER=anthropic | zai
# AI_PROVIDER=
# It searches and reads the web through remote MCP servers: comma-separated URLs, read-only tools only
# (default: Parallel's free https://mcp.parallel.ai/mcp; a key only raises its limits, platform.parallel.ai).
# OPERATOR_SOURCES=https://mcp.parallel.ai/mcp
# PARALLEL_API_KEY=
# OPERATOR_BRIEF=operator.md
# OPERATOR_MAX_TOOL_CALLS=40
